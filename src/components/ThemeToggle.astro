<button class="theme-toggle" type="button" aria-label="切换暗黑模式" title="切换暗黑模式"><span class="sun">☼</span><span class="moon">◐</span></button>
<script is:inline>
  (() => {
    const bindThemeToggle = () => {
      const button = document.querySelector('.theme-toggle');
      if (!(button instanceof HTMLElement) || button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        document.documentElement.style.backgroundColor = next === 'dark' ? '#151515' : '#f7f7f5';
        localStorage.setItem('theme', next);
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindThemeToggle);
    else bindThemeToggle();
  })();
</script>
