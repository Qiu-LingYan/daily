---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() { return (await getCollection('daily')).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={entry.data.title}><article class="post"><a class="back-link" href={import.meta.env.BASE_URL}>← 返回全部记录</a><header class="post-header"><span class="eyebrow">{formatDate(entry.data.date)}</span><h1>{entry.data.title}</h1><p>Written by {entry.data.writer}</p><img class="moe-counter" src={`https://count.getloli.com/get/@qiulingyan-blog-${entry.id}?theme=moebooru`} alt="本文阅读量" loading="lazy" /></header><div class="prose"><Content /></div></article></BaseLayout>
